# Copy to .env and fill in values for local development

NODE_ENV=development

# Database — runtime uses PgBouncer; migrations use direct Postgres
DATABASE_POOL_URL=postgresql://postgres:postgres@localhost:6432/qa_automater
DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/qa_automater
# Legacy fallback (prefer POOL/MIGRATE URLs above)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/qa_automater

# Application pool sizing (per API/worker instance)
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Set true in tests to skip pgvector startup probe
DATABASE_SKIP_STARTUP_VERIFY=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 Storage
S3_BUCKET_NAME=qa-automater-artifacts-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# AI
OPENAI_API_KEY=

# Auth
JWT_SECRET=change-me-in-production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dGhhbmtmdWwtb29zdGVyLTMyLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_placeholder_secret_key


# AWS (deploy / localstack)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=
ECR_REPOSITORY=qa-automater

# Service ports (local)
PORT=3000
WEB_PORT=3001

