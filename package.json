{
  "name": "qa-automater",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered automated test generation platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @qa-automater/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @qa-automater/database migrate:dev",
    "db:verify": "pnpm --filter @qa-automater/database verify"
  },
  "devDependencies": {
    "@qa-automater/eslint-config": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
