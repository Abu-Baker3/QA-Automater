    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.718.0",
    "@aws-sdk/s3-request-presigner": "^3.718.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.30.1",
    "@qa-automater/types": "workspace:*",
    "@types/jszip": "^3.4.1",
    "bullmq": "^5.34.1",
    "ioredis": "^5.4.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@qa-automater/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
